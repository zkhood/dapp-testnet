# ---------------------------------------------------------------------------
# ZKHood dApp backend — environment template
# Copy this file to `.env` and fill in the values. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# JSON-RPC endpoint of Robinhood Chain testnet (chainId 46630).
# Rate-limited public default exists in code; for real use put your own RPC URL.
ROBINHOOD_TESTNET_RPC_URL=

# Relayer private key that signs settleBatch / withdrawals (testnet). KEEP SECRET.
DEPLOYER_PRIVATE_KEY=

# Enclave blind-sequencer URL (default http://127.0.0.1:4100).
BLIND_URL=

# Oyster worker URL (default http://127.0.0.1:4000).
OYSTER_URL=

# Backend listen port (default 8788).
PORT=
