# ---------------------------------------------------------------------------
# ZKHood dApp — environment placeholders
# Copy this file to `.env` and fill in real values before deploying to a
# public network. Local development (hardhat node) needs NONE of these.
# NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# JSON-RPC endpoint of the target chain (Robinhood Chain testnet).
# Public endpoint below is rate-limited; for real use, put your Alchemy URL:
# https://robinhood-testnet.g.alchemy.com/v2/YOUR_API_KEY
RPC_URL=

# Numeric chain id of that network (Robinhood Chain testnet).
CHAIN_ID=

# Deployer private key (funded with native gas token). KEEP SECRET.
PRIVATE_KEY=

# Optional: block explorer API key for contract verification.
EXPLORER_API_KEY=

# Optional backend endpoints for the real TEE + ZK services (used later by
# the frontend / relayer, not by Hardhat).
TEE_ATTESTATION_URL=
ZK_PROVER_URL=
